{
  "name": "@isl/shared-types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript type contracts for the ISL platform (API DTOs + real-time events + domain models).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts"
  }
}
