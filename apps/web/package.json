{
  "name": "@isl/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ISL platform web app (React + Vite + TypeScript, claymorphism accessibility-first UI).",
  "scripts": {
    "copy:mediapipe": "node scripts/copy-mediapipe-assets.js",
    "predev": "npm run copy:mediapipe",
    "dev": "vite",
    "prebuild": "npm run copy:mediapipe",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@babylonjs/core": "^8.56.2",
    "@babylonjs/loaders": "^8.56.2",
    "@isl/shared-types": "*",
    "@mediapipe/hands": "^0.4.1675469240",
    "@reduxjs/toolkit": "^2.5.0",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.28.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
