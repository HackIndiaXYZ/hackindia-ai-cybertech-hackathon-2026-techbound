# =============================================================================
# ISL Real-Time Communication Platform — Environment Configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Core ---
NODE_ENV=development
LOG_LEVEL=debug

# --- API (apps/api) ---
API_HOST=0.0.0.0
API_PORT=4000
CORS_ALLOWED_ORIGINS=http://localhost:5173
API_AUTH_JWT_SECRET=change-me-in-production
API_AUTH_TOKEN_TTL_SECONDS=900
# 4E.2 rotating refresh token lifetime (default 7 days).
API_AUTH_REFRESH_TTL_SECONDS=604800
# 5.2 single-use password-reset token lifetime (default 30 minutes).
API_AUTH_RESET_TTL_SECONDS=1800

# --- Mail (5.2 password reset) ---
# Pluggable transport, no hard dependency. 'console' records that a message was
# produced (dev/test), 'none' swallows it. A real SMTP/SES transport plugs in
# behind an ADR (docs/DECISIONS.md).
MAIL_TRANSPORT=console
MAIL_FROM=no-reply@missingwhisper.local
# Public origin used to build the reset link emailed to users.
PUBLIC_WEB_BASE_URL=http://localhost:5173

# --- Cloudflare Turnstile (5.3) ---
# Off by default. When enabled the API verifies a widget token on /signup and
# /login before accepting credentials (fail-closed). The secret is server-only;
# the site key is public and prefixed VITE_ so it ships in the web bundle.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
# https://challenges.cloudflare.com/turnstile/v0/siteverify (default)
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# --- Frontend (apps/web) ---
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_WS_BASE_URL=http://localhost:4000
# Public Turnstile site key; leave blank to render no widget (dev/test).
VITE_TURNSTILE_SITE_KEY=

# --- Data persistence ---
# DB_DRIVER: postgres | fallback (fallback uses an in-memory store so the app
# runs locally without a Postgres install; see docs/DECISIONS.md ADR-002)
DB_DRIVER=fallback
DATABASE_URL=postgres://isl:isl@localhost:5432/isl

# --- Cache / ephemeral state ---
# REDIS_DRIVER: redis | fallback (fallback is an in-memory TTL store)
REDIS_DRIVER=fallback
REDIS_URL=redis://localhost:6379

# --- WebRTC signaling / media ---
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- AI service providers ---
# These flags are RESOLVED, not assumed: GET /api/v1/providers is the single
# source of provider truth, and a value with no implementation makes /health
# report degraded and boot log an error-grade warning (we never silently fall
# back). Implemented today vs reserved for the future:
SPEECH_PROVIDER=stub            # implemented: 'stub' (on-device browser Web Speech). Reserved: 'whisper' (no integration exists yet)
SPEECH_SERVICE_BASE_URL=http://localhost:8001   # only meaningful once a real server speech integration exists
VISION_PROVIDER=mediapipe       # implemented: 'mediapipe' (on-device hand-shape heuristic, NOT trained ISL), 'stub' (disabled). Reserved: anything else
TRANSLATION_PROVIDER=rulebased  # implemented: 'rulebased' (on-device glossary prototype). Reserved: 'llm' (no integration exists yet)
TTS_PROVIDER=stub               # implemented: 'stub' (on-device browser SpeechSynthesis). Reserved: real provider names

# --- Privacy ---
RECORDING_CONSENT_REQUIRED=true
MEDIA_RETENTION_ENABLED=false
